---
import { config, asset } from "../config";
---

<section id="galerij" class="galerij-sectie">
  <div class="container sectie-header fade-up">
    <p class="sectie-label">Ons werk</p>
    <h2 class="sectie-titel">Galerij</h2>
  </div>

  <div class="foto-grid fade-up">
    {
      config.galerij.map((foto, i) => (
        <div class={`foto-item item-${i + 1}`}>
          <img src={asset(foto.src)} alt={foto.alt} loading="lazy" />
        </div>
      ))
    }
  </div>

  <div class="container cta">
    {config.socials.instagram && (
      <a href={config.socials.instagram} target="_blank" rel="noopener" class="boek-knop outline-knop">
        VOLG ONS OP INSTAGRAM
      </a>
    )}
    {config.socials.facebook && (
      <a href={config.socials.facebook} target="_blank" rel="noopener" class="boek-knop">
        VOLG ONS OP FACEBOOK
      </a>
    )}
  </div>
</section>

<style>
  .galerij-sectie {
    padding-bottom: 5rem;
  }

  .sectie-header {
    text-align: center;
    margin-bottom: 0;
  }

  .sectie-header .sectie-titel {
    margin-bottom: 3rem;
  }

  .foto-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto;
    gap: 6px;
    margin-bottom: 4rem;
  }

  /* Eerste foto iets groter voor visueel accent */
  .foto-item.item-1 {
    grid-column: span 2;
  }

  .foto-item {
    overflow: hidden;
    background-color: var(--grijs-licht);
    aspect-ratio: 4 / 3;
  }

  .foto-item.item-1 {
    aspect-ratio: 16 / 9;
  }

  .foto-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }

  .foto-item:hover img {
    transform: scale(1.05);
  }

  .cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .outline-knop {
    background-color: transparent;
    border: 1px solid var(--zwart);
    color: var(--zwart);
  }

  .outline-knop:hover {
    background-color: var(--zwart);
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .foto-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .foto-item.item-1 {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 480px) {
    .foto-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4px;
    }
  }
</style>
