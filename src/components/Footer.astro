---
import { config, asset } from "../config";

const jaar = new Date().getFullYear();
---

<footer>
  <div class="container footer-inner">

    <div class="footer-top">
      <a href="#home" class="footer-logo">
        <img src={asset("/images/logo.png")} alt={config.bedrijfsnaam} class="footer-logo-img" />
      </a>

      <a href={config.freshaLink} target="_blank" rel="noopener" class="boek-knop footer-boek">
        {config.hero.knopTekst}
      </a>
    </div>

    <hr class="lijn footer-lijn" />

    <div class="footer-mid">

      <div class="footer-adres">
        <p class="footer-label">LOCATIE</p>
        <p>{config.adres}<br />{config.postcode} {config.stad}</p>
      </div>

      <div class="footer-contact">
        <p class="footer-label">CONTACT</p>
        <p>
          <a href={`tel:${config.telefoon.replace(/[\s-]/g, "")}`}>{config.telefoon}</a><br />
          <a href={`mailto:${config.email}`}>{config.email}</a>
        </p>
      </div>

      <div class="footer-social">
        <p class="footer-label">VOLG ONS</p>
        <div class="social-links">
          {config.socials.instagram && (
            <a href={config.socials.instagram} target="_blank" rel="noopener">Instagram</a>
          )}
          {config.socials.facebook && (
            <a href={config.socials.facebook} target="_blank" rel="noopener">Facebook</a>
          )}
          {config.socials.tiktok && (
            <a href={config.socials.tiktok} target="_blank" rel="noopener">TikTok</a>
          )}
          {config.socials.whatsapp && (
            <a href={config.socials.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
          )}
        </div>
      </div>

    </div>

    <hr class="lijn footer-lijn" />

    <p class="footer-copy">
      &copy; {jaar} {config.bedrijfsnaam} — {config.stad}
    </p>

  </div>
</footer>

<style>
  footer {
    background-color: var(--zwart);
    color: #ffffff;
    padding: 5rem 2rem 3rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
  }

  .footer-logo-img {
    height: 48px;
    width: auto;
    display: block;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .footer-boek {
    background-color: transparent;
    border: 1px solid rgba(255,255,255,0.4);
    color: #ffffff;
    font-size: 0.65rem;
    padding: 0.75rem 2rem;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .footer-boek:hover {
    border-color: #ffffff;
    background-color: #ffffff;
    color: var(--zwart);
  }

  .footer-lijn {
    border-color: rgba(255,255,255,0.12);
    margin: 2.5rem 0;
  }

  .footer-mid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-label {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 0.9rem;
  }

  .footer-adres p,
  .footer-contact p,
  .footer-contact a {
    font-size: 0.88rem;
    font-weight: 300;
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
  }

  .footer-contact a:hover,
  .social-links a:hover {
    color: #ffffff;
    transition: color 0.2s;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-links a {
    font-size: 0.88rem;
    font-weight: 300;
    color: rgba(255,255,255,0.7);
  }

  .footer-copy {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.25);
    letter-spacing: 0.08em;
    text-align: center;
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .footer-mid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-social {
      grid-column: span 2;
    }
  }

  @media (max-width: 400px) {
    .footer-mid {
      grid-template-columns: 1fr;
    }

    .footer-social {
      grid-column: span 1;
    }
  }
</style>
